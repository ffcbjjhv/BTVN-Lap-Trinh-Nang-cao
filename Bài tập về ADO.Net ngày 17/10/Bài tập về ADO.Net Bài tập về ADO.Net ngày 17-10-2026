    public class DataHelper
    {
        private SqlConnection con;
        private string connectionString;

        public DataHelper()
        {
            this.connectionString = @"Server=LAPTOP-6SN65NCS\HUECTMDB; Database=QLSV;Integrated Security=True; TrustServerCertificate=true";
            con = new SqlConnection(connectionString);
        }

        public void OpenConnection()
        {
            try
            {
                if (con.State == ConnectionState.Closed)
                {
                    con.Open();
                }
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi mở kết nối CSDL: " + ex.Message);
            }
        }

        public void CloseConnection()
        {
            try
            {
                if (con.State == ConnectionState.Open)
                {
                    con.Close();
                }
            }
            catch (Exception ex)
            {
                throw new Exception("Lỗi đóng kết nối CSDL: " + ex.Message);
            }
        }

        public void ExecuteNonQuery(string sqlExcuteQuery)
        {
            try
            {
                OpenConnection();
                SqlCommand comand = new SqlCommand(sqlExcuteQuery, con);
                comand.ExecuteNonQuery();
                comand.Dispose();
            }
            catch (Exception exx)
            {
                throw new Exception("Lỗi thực thi câu lệnh SQL: " + exx.Message);
            }
            finally
            {
                CloseConnection();
            }
        }

        public SqlDataReader ExcuteReader(string sqlSelect)
        {
            try
            {
                OpenConnection();
                SqlCommand comand = new SqlCommand(sqlSelect, con);
                SqlDataReader red = comand.ExecuteReader(CommandBehavior.CloseConnection);
                return red;
            }
            catch (Exception exx)
            {
                CloseConnection();
                throw new Exception("Lỗi đọc dữ liệu (ExcuteReader): " + exx.Message);
            }
        }

        public DataTable GetDataTable(string sqlSelect)
        {
            try
            {
                SqlDataAdapter da = new SqlDataAdapter(sqlSelect, con);
                DataTable dt = new DataTable();
                da.Fill(dt);
                return dt;
            }
            catch (Exception exx)
            {
                throw new Exception("Lỗi lấy bảng dữ liệu (GetDataTable): " + exx.Message);
            }
            finally
            {
                CloseConnection();
            }
        }
    }

